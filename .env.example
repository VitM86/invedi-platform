# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.

# Mapbox public token — used by the terrain bird-view map (/comporta) and the live
# Explore / project maps. Use a PUBLIC token (starts with "pk."). Safe for the browser;
# restrict it by URL in the Mapbox dashboard before production:
# https://account.mapbox.com/access-tokens/
#
# Optional for local dev: without it, every map falls back to a static placeholder, so the
# app still runs — you just won't see live Mapbox tiles. Ask Vitaliy for the project token.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
